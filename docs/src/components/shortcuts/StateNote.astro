---
import { resolveLocaleFromPathname } from "../../utils/i18n";

interface Props {
  partialClass: string;
}

const { partialClass } = Astro.props as Props;
const locale = resolveLocaleFromPathname(Astro.url.pathname);

const t =
  locale === "fr"
    ? {
        heading: "Appliquer ces styles à des états spécifiques",
        intro:
          "Utilisez un préfixe d’état pour appliquer cette classe uniquement à un état d’interaction spécifié. Voici les états possibles :",
        link: 'En savoir plus sur le <gcds-link href="/fr/raccourcis-css/etat">préfixe d’état</gcds-link>.',
      }
    : {
        heading: "Apply this style to specific states",
        intro:
          "Use a state prefix to apply this class only to a specified interaction state. The available states are:",
        link: 'Learn more about the <gcds-link href="/en/css-shortcuts/state">state prefix</gcds-link>.',
      };

const snippet = `<div class="hover:${partialClass} ...">\n  ...\n</div>`;
---

<gcds-heading tag="h3">{t.heading}</gcds-heading>
<gcds-text>{t.intro}</gcds-text>
<ul class="list-disc mb-300">
  <li><code>hover</code></li>
  <li><code>focus</code></li>
</ul>
<pre class="shortcut-snippet"><code>{snippet}</code></pre>
<gcds-text set:html={t.link} />
