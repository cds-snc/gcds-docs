---
import { buildSideNavConfig } from '../routing/routes';

// Navigation in this component is manifest-driven.
// Add or update items in: src/routing/route-manifest.json
// - Add top-level links under sideNavRoutes with "type": "link"
// - Add grouped items under sideNavRoutes with "type": "group" and either "items" or "manifestKey"
// - Add/update the home slot using "type": "slot" and "slotName": "home"
const navConfig = buildSideNavConfig(Astro.url.pathname);

// Highlight the active link and open the group that contains it.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalize = (href: string) => href.replace(/\/+$/, '') || '/';

type NavGroupLike = {
  links: Array<{ href: string }>;
  subGroups?: Array<{ links: Array<{ href: string }> }>;
};

// Include sub-tab pages as active links
const allHrefs = [
  ...navConfig.links.map((link) => link.href),
  ...navConfig.groups.flatMap((group) => [
    ...group.links.map((link) => link.href),
    ...(group.subGroups?.flatMap((sub) => sub.links.map((link) => link.href)) ?? []),
  ]),
];
const bestMatch = allHrefs
  .map(normalize)
  .filter((base) => base === currentPath || currentPath.startsWith(`${base}/`))
  .sort((a, b) => b.length - a.length)[0];
const isCurrent = (href: string) => bestMatch !== undefined && normalize(href) === bestMatch;

// A group is active if it (or any of its sub-groups) contains the current page.
const groupIsActive = (group: NavGroupLike) => {
  const allLinks = [...group.links, ...(group.subGroups?.flatMap((sub) => sub.links) ?? [])];

  return allLinks.some((link) => {
    const base = normalize(link.href);
    return base === currentPath || currentPath.startsWith(`${base}/`);
  });
};

const hasVersion = /\/components\/\d+\.\d+\.\d+\//.test(Astro.url.pathname) || /\/composants\/\d+\.\d+\.\d+\//.test(Astro.url.pathname);

const TagNav = hasVersion ? 'gcds-side-nav-latest' : 'gcds-side-nav';
const TagGroup = hasVersion ? 'gcds-nav-group-latest' : 'gcds-nav-group';
const TagLink = hasVersion ? 'gcds-nav-link-latest' : 'gcds-nav-link';
---

<TagNav label={navConfig.sideNavLabel} class="lg:position-sticky box-border overflow-x-visible align-self-start px-75">
  {navConfig.homeSlot && (
    // Home slot is intentionally never marked current (no active highlight).
    <TagLink slot="home" href={navConfig.homeSlot.href}>{navConfig.homeSlot.text}</TagLink>
  )}

  {navConfig.links.map((link) => (
    <TagLink href={link.href} current={isCurrent(link.href) || undefined}>{link.text}</TagLink>
  ))}

  {navConfig.groups.map((group) => (
    <TagGroup open-trigger={group.trigger} menu-label={group.menuLabel} open={groupIsActive(group) || undefined}>
      {group.links.map((link) => (
        <TagLink href={link.href} current={isCurrent(link.href) || undefined}>{link.text}</TagLink>
      ))}
      {group.subGroups?.map((sub) => (
        <TagGroup open-trigger={sub.trigger} menu-label={sub.menuLabel} open={groupIsActive(sub) || undefined}>
          {sub.links.map((link) => (
            <TagLink href={link.href} current={isCurrent(link.href) || undefined}>{link.text}</TagLink>
          ))}
        </TagGroup>
      ))}
    </TagGroup>
  ))}
</TagNav>

<style>
  gcds-side-nav {
    top: 0;
    max-height: 100dvh;
    overflow-y: auto;

    /* avoids jump when the scrollbar appears */
    scrollbar-gutter: stable;

    /* Room for the nav-link focus ring so overflow doesn't clip it.  */
    padding-block: var(--gcds-spacing-100);
    margin-block: calc(-1 * var(--gcds-spacing-100));
  }
</style>
