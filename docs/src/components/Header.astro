---
import { defaultLocale, routes, supportedLocales, type Locale } from '../i18n/config';
import { buildLocalizedRoutePath, getPathParts } from '../utils/i18n';

interface Props {
  currentLocale: Locale;
  routeKey: string;
}

const { currentLocale, routeKey } = Astro.props as Props;
const otherLocale = supportedLocales.find((locale) => locale !== currentLocale) ?? defaultLocale;

// Keep the design/code tab when toggling language (slugs are the same in both locales).
const parts = getPathParts(Astro.url.pathname);
const lastSegment = parts[parts.length - 1];
const onComponentSection = parts[1] === routes.components[currentLocale];
const tabSuffix =
  onComponentSection && (lastSegment === 'design' || lastSegment === 'code')
    ? `/${lastSegment}`
    : '';

const href = buildLocalizedRoutePath(routeKey, otherLocale, routes) + tabSuffix;
---

<gcds-header
  lang={currentLocale}
  lang-href={href}
  skip-to-href="#main-content"
>
  <gcds-search slot="search"></gcds-search>
</gcds-header>
