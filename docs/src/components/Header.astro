---
import { defaultLocale, routes, supportedLocales, type Locale } from '../i18n/config';
import { buildLocalizedPath } from '../utils/i18n';

interface Props {
  currentLocale: Locale;
  routeKey: string;
}

const { currentLocale } = Astro.props as Props;
const otherLocale = supportedLocales.find((locale) => locale !== currentLocale) ?? defaultLocale;

// Translate the current path segment-by-segment so the toggle lands on the
// equivalent page in the other locale, at any depth (tabs, dev framework pages).
const href = buildLocalizedPath(Astro.url.pathname, currentLocale, otherLocale, routes);
---

<gcds-header
  lang={currentLocale}
  lang-href={href}
  skip-to-href="#main-content"
>
  <gcds-search slot="search"></gcds-search>
</gcds-header>
