---
const { figma, github } = Astro.props;
---

<ul class="doc-links d-flex flex-wrap gap-300 mb-450">
  {
    github && (
      <li class="github-link">
        <gcds-link external href={github}>GitHub</gcds-link>
      </li>
    )
  }
  {
    figma && (
      <li class="figma-link">
        <gcds-link external href={figma}>Figma</gcds-link>
      </li>
    )
  }
</ul>
