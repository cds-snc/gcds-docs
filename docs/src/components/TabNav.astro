---
import { resolveLocaleFromPathname } from '../utils/i18n';

const locale = resolveLocaleFromPathname(Astro.url.pathname);

const path = Astro.url.pathname.replace(/\/$/, '');
const base = path.replace(/\/(design|code)$/, '');
const active = /\/design$/.test(path)
  ? 'design'
  : /\/code$/.test(path)
    ? 'code'
    : 'use-case';

const labels = {
  en: { useCase: 'Use case', design: 'Design', code: 'Code', aria: 'Guidance tabs' },
  fr: {
    useCase: "Cas d'utilisation",
    design: 'Design',
    code: 'Code',
    aria: 'Onglet de consignes',
  },
}[locale];

const tabs = [
  { key: 'use-case', label: labels.useCase, href: `${base}/` },
  { key: 'design', label: labels.design, href: `${base}/design/` },
  { key: 'code', label: labels.code, href: `${base}/code/` },
];
---

<nav class="tabs mb-300" aria-label={labels.aria}>
  <ul>
    {
      tabs.map((tab) => (
        <li class="tab">
          <a href={tab.href} aria-current={tab.key === active ? 'page' : undefined}>
            {tab.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  nav.tabs {
    ul {
      list-style: none;
      margin-inline-start: 0;
      margin-block-end: var(--gcds-spacing-600);
      width: var(--gcds-container-full);
      display: flex;
      background-color: var(--gcds-color-grayscale-0);
      gap: var(--gcds-spacing-75);
      flex-wrap: wrap;
      border-block-end: var(--gcds-border-width-md) solid
        var(--gcds-color-grayscale-100);
    }

    a {
      display: block;
      border-radius: var(--gcds-button-border-radius)
        var(--gcds-button-border-radius) 0 0;
      padding: var(--gcds-spacing-150) var(--gcds-spacing-150)
        var(--gcds-spacing-100) var(--gcds-spacing-150);
      color: var(--gcds-link-default);
      margin-block-start: var(--gcds-spacing-100);
      margin-block-end: var(--gcds-spacing-25);

      &[aria-current='page'] {
        background-color: var(--gcds-color-grayscale-0);
        border: var(--gcds-border-width-md) solid var(--gcds-color-grayscale-100);
        border-block-end: 0 solid var(--gcds-color-grayscale-0);
        box-shadow: 0 var(--gcds-border-width-xl) 0
          calc(var(--gcds-border-width-md) * -1) var(--gcds-color-grayscale-0);
        text-decoration: none;
        font-weight: bold;
        padding: var(--gcds-spacing-225) var(--gcds-spacing-150)
          var(--gcds-spacing-175) var(--gcds-spacing-150);
        margin-block-start: 0;
        margin-block-end: 0;
        pointer-events: none;
      }

      &:hover {
        background-color: var(--gcds-color-grayscale-50);
      }

      &:active {
        color: var(--gcds-focus-text) !important;
      }

      &:focus {
        background-color: var(--gcds-focus-background);
        color: var(--gcds-focus-text);
        text-decoration: none;
      }

      &[aria-current='page']:focus {
        border-color: var(--gcds-focus-background);
      }
    }
  }
</style>
