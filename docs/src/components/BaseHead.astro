---
interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props as Props;
---

{/*
  Domain/language routing. Amplify custom rules can't match on the Host header, so this
  runs in the browser, before anything else loads.
    design-system.*   + /       -> /en/
    systeme-design.*  + /       -> /fr/
    design-system.*   + /fr/... -> same path on systeme-design.*
    systeme-design.*  + /en/... -> same path on design-system.*
  A host matches only when one of its dot-separated labels is EXACTLY a site name, and
  only the rightmost such label is swapped. That keeps any prefix intact, so it works on
  astro-staging.*, *.test and *.localhost, and it can't be fooled by a prefix that merely
  contains a site name. Hosts matching neither name (amplifyapp.com, localhost, 127.0.0.1)
  are left alone, which is what makes the bilingual splash page reviewable on the default
  Amplify domain.
*/}
<script is:inline>
  (function () {
    const EN = 'design-system';
    const FR = 'systeme-design';

    const labels = location.hostname.split('.');
    let i = -1;
    for (let n = labels.length - 1; n >= 0; n--) {
      if (labels[n] === EN || labels[n] === FR) { i = n; break; }
    }
    if (i === -1) return;

    const onFr = labels[i] === FR;
    const p = location.pathname;

    if (p === '/') { location.replace(onFr ? '/fr/' : '/en/'); return; }

    if (onFr && /^\/en(\/|$)/.test(p)) labels[i] = EN;
    else if (!onFr && /^\/fr(\/|$)/.test(p)) labels[i] = FR;
    else return;

    const port = location.port ? ':' + location.port : '';
    location.replace(
      location.protocol + '//' + labels.join('.') + port + p + location.search + location.hash
    );
  })();
</script>

{/* Google Analytics */}
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5TBZBZVVK8"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', 'G-5TBZBZVVK8');
</script>

{/* Click tracking, ported from eleventy */}
<script>
  document.addEventListener('click', function (e) {
    // Find the closest clickable element (button, a, gcds-button, gcds-link)
    const el = e.target.closest('button, a, gcds-button, gcds-link');
    if (!el) return;

    // Only track left-clicks or keyboard activations
    if (e.button !== 0) return;

    // Get label and url
    const label = el.textContent ? el.textContent.trim() : '';
    const rawUrl =
      el.getAttribute('href') ||
      el.getAttribute('data-href') ||
      window.location.href;

    let safeUrl = window.location.pathname;
    try {
      const parsed = new URL(rawUrl, window.location.origin);
      // Only allow http(s) URLs and strip query/hash to avoid leaking PII
      if (parsed.protocol === 'http:' || parsed.protocol === 'https:') {
        safeUrl = parsed.pathname;
      }
    } catch (err) {
      // If URL parsing fails, keep the fallback safeUrl (current pathname)
    }

    if (typeof window.gtag !== 'undefined') {
      window.gtag('event', 'click', {
        event_category: 'gcds_click',
        event_label: label,
        event_url: safeUrl,
      });
    }
  });
</script>

<meta charset="utf-8" />
<link rel="icon" href="/favicon.ico" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle} | GC Design System</title>
<meta name="og:title" content={`${pageTitle} | GC Design System`} />

<!-- GC Design System CSS Shortcuts -->
<link rel="stylesheet" href="/assets/gcds/gcds-css-shortcuts.min.css" />

<!-- GC Design System -->
<link rel="stylesheet" href="/assets/gcds/gcds.css" />
<script type="module" src="/assets/gcds/gcds.esm.js"></script>

<!-- GC Design System Extension - Code display -->
<script type="module" src="/assets/gcds/gcds-ext-code-display.esm.js"></script>

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />
