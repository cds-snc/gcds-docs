---
interface Props {
  pageTitle: string;
}

import { getPathParts } from 'src/utils/i18n';

const { pageTitle } = Astro.props as Props;

const hasVersion = /\/components\/\d+\.\d+\.\d+\//.test(Astro.url.pathname) || /\/composants\/\d+\.\d+\.\d+\//.test(Astro.url.pathname);
const version = hasVersion ? getPathParts(Astro.url.pathname)[2] : '';
---

{/*
  Domain/language routing. Amplify custom rules can't match on the Host header, so this
  runs in the browser, before anything else loads.
    design-system.*   + /       -> /en/
    systeme-design.*  + /       -> /fr/
    design-system.*   + /fr/... -> same path on systeme-design.*
    systeme-design.*  + /en/... -> same path on design-system.*
  Hosts with neither name (amplifyapp.com, localhost, 127.0.0.1) are left alone.
  Swapping the name inside the host keeps prefixes and ports, so it also works on
  astro-staging.*, *.test and *.localhost.
*/}
<script is:inline>
  (function () {
    const h = location.hostname;
    const p = location.pathname;
    const onFr = h.indexOf('systeme-design') !== -1;
    const onEn = !onFr && h.indexOf('design-system') !== -1;
    if (!onEn && !onFr) return;

    if (p === '/') { location.replace(onFr ? '/fr/' : '/en/'); return; }

    let host = null;
    if (onEn && /^\/fr(\/|$)/.test(p)) host = location.host.replace('design-system', 'systeme-design');
    else if (onFr && /^\/en(\/|$)/.test(p)) host = location.host.replace('systeme-design', 'design-system');
    if (host) location.replace(location.protocol + '//' + host + p + location.search + location.hash);
  })();
</script>

<meta charset="utf-8" />
<link rel="icon" href="/favicon.ico" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle} | GC Design System</title>
<meta name="og:title" content={`${pageTitle} | GC Design System`} />

<!-- GC Design System CSS Shortcuts -->
<link rel="stylesheet" href="/assets/shortcuts/gcds-css-shortcuts.min.css" />

{hasVersion ? 
  <script is:inline type="module">
    import { setTagTransformer } from '/assets/components/dist/index.js';
    import { defineCustomElements } from '/assets/components/loader/index.js';

    const transformTag = (tagName) => {
      if (!tagName.startsWith('gcds-') || tagName.endsWith('-latest')) {
        return tagName;
      }

      return `${tagName}-latest`;
    };

    setTagTransformer(transformTag);

    await defineCustomElements(window, {
      transformTagName: transformTag,
    });
  </script>

  <!-- GC Design System -->
  <link rel="stylesheet" href="/assets/components/dist/gcds/gcds.css" />
  <!-- <script type="module" src="/assets/components/dist/gcds/gcds.esm.js"></script> -->

  <link
    rel="stylesheet"
    href={`/assets/components/${version}/gcds.css`}
  />
  <script
    type="module"
    src={`/assets/components/${version}/gcds.esm.js`}
  ></script>
:
  <!-- GC Design System -->
  <link rel="stylesheet" href="/assets/components/dist/gcds/gcds.css" />
  <script type="module" src="/assets/components/dist/gcds/gcds.esm.js"></script>
}

<!-- GC Design System Extension - Code display -->
<script type="module" src="/assets/code-display/gcds-ext-code-display.esm.js"></script>

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />
