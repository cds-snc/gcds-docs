---
interface Props {
  pageTitle: string;
  currentLocale?: string;
}

const { pageTitle, currentLocale } = Astro.props as Props;
const isFrench = currentLocale?.startsWith('fr') ?? false;
---

{/*
  Domain/language routing. Amplify custom rules can't match on the Host header, so this
  runs in the browser, before anything else loads.
    design-system.*   + /       -> /en/
    systeme-design.*  + /       -> /fr/
    design-system.*   + /fr/... -> same path on systeme-design.*
    systeme-design.*  + /en/... -> same path on design-system.*
  A host matches only when one of its dot-separated labels is EXACTLY a site name, and
  only the rightmost such label is swapped. That keeps any prefix intact, so it works on
  astro-staging.*, *.test and *.localhost, and it can't be fooled by a prefix that merely
  contains a site name. Hosts matching neither name (amplifyapp.com, localhost, 127.0.0.1)
  are left alone, which is what makes the bilingual splash page reviewable on the default
  Amplify domain.
*/}
<script is:inline>
  (function () {
    const EN = 'design-system';
    const FR = 'systeme-design';

    const labels = location.hostname.split('.');
    let i = -1;
    for (let n = labels.length - 1; n >= 0; n--) {
      if (labels[n] === EN || labels[n] === FR) { i = n; break; }
    }
    if (i === -1) return;

    const onFr = labels[i] === FR;
    const p = location.pathname;

    if (p === '/') { location.replace(onFr ? '/fr/' : '/en/'); return; }

    if (onFr && /^\/en(\/|$)/.test(p)) labels[i] = EN;
    else if (!onFr && /^\/fr(\/|$)/.test(p)) labels[i] = FR;
    else return;

    const port = location.port ? ':' + location.port : '';
    location.replace(
      location.protocol + '//' + labels.join('.') + port + p + location.search + location.hash
    );
  })();
</script>

{/* Google Analytics */}
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5TBZBZVVK8"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', 'G-5TBZBZVVK8');
</script>

{/* Click tracking, ported from eleventy */}
<script>
  document.addEventListener('click', function (e) {
    // Find the closest clickable element (button, a, gcds-button, gcds-link)
    const el = e.target.closest('button, a, gcds-button, gcds-link');
    if (!el) return;

    // Only track left-clicks or keyboard activations
    if (e.button !== 0) return;

    // Get label and url
    const label = el.textContent ? el.textContent.trim() : '';
    const rawUrl =
      el.getAttribute('href') ||
      el.getAttribute('data-href') ||
      window.location.href;

    let safeUrl = window.location.pathname;
    try {
      const parsed = new URL(rawUrl, window.location.origin);
      // Only allow http(s) URLs and strip query/hash to avoid leaking PII
      if (parsed.protocol === 'http:' || parsed.protocol === 'https:') {
        safeUrl = parsed.pathname;
      }
    } catch (err) {
      // If URL parsing fails, keep the fallback safeUrl (current pathname)
    }

    if (typeof window.gtag !== 'undefined') {
      window.gtag('event', 'click', {
        event_category: 'gcds_click',
        event_label: label,
        event_url: safeUrl,
      });
    }
  });

  // Adobe Analytics: outbound (event26) and download (event25) links.
  // GCDS components render their <a> inside shadow DOM, which Adobe's own click
  // rules can't see, and Adobe's click-based outbound rule needs jQuery (WET).
  // Pushing "exit"/"download" to the Adobe data layer avoids both. Runs in the
  // capture phase so it can mark the link exempt before Adobe's click rules run,
  // which stops a second beacon for plain <a> links.
  const AA_DOWNLOAD_EXT = /\.(csv|docx?|epub|json|pdf|pptx?|rtf|txt|xlsx?|xml|zip)$/i;
  const AA_BLOCKED_PROTOCOLS = ['javascript:', 'mailto:', 'tel:', 'blob:', 'data:'];

  function aaIsInternal(hostname: string): boolean {
    const filters: string[] = (window as any)._satellite?.gcCustom?.internal_filters || [];
    return hostname === window.location.hostname || filters.includes(hostname);
  }

  window.addEventListener(
    'click',
    function (e) {
      if (e.button !== 0) return;

      // composedPath() reaches into open shadow roots (gcds-link, gcds-button, …)
      const a = e
        .composedPath()
        .find((n): n is HTMLAnchorElement => n instanceof HTMLAnchorElement && !!n.href);
      if (!a || AA_BLOCKED_PROTOCOLS.includes(a.protocol)) return;

      let url: URL;
      try {
        url = new URL(a.href);
      } catch (err) {
        return;
      }

      const isDownload = a.hasAttribute('download') || AA_DOWNLOAD_EXT.test(url.pathname);
      if (!isDownload && aaIsInternal(url.hostname)) return;

      // Link text: the anchor itself, or the GCDS host element when the text is slotted
      const host = (a.getRootNode() as ShadowRoot).host as HTMLElement | undefined;
      const label = (
        a.textContent?.trim() ||
        host?.textContent?.trim() ||
        a.getAttribute('aria-label') ||
        ''
      ).replace(/\s+/g, ' ');

      // Stop Adobe's own click rules from also tracking this link
      a.setAttribute('data-gc-analytics-exempt', '');

      const w = window as any;
      w.adobeDataLayer = w.adobeDataLayer || [];
      w.adobeDataLayer.push({
        event: isDownload ? 'download' : 'exit',
        // Strip query/hash, same as the GA handler, to avoid leaking PII
        userEvent: { label, link: url.origin + url.pathname },
      });
    },
    true
  );
</script>

<meta charset="utf-8" />
<link rel="icon" href="/favicon.ico" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle} | GC Design System</title>
<meta name="og:title" content={`${pageTitle} | GC Design System`} />

<!-- Adobe Analytics metadata -->
<meta name="dcterms.title" content={pageTitle} />
<meta name="dcterms.language" content={isFrench ? 'fra' : 'eng'} />
<meta name="dcterms.creator" content={isFrench ? 'Service numérique canadien' : 'Canadian Digital Service' } /> <!-- verify with AA with an email -->
<meta name="dcterms.accessRights" content="2" /> <!-- 1=secured/login-required, 2=public, 3=intranet/extranet -->
<meta name="gcaaterms.sitename" content="ESDC-EDSC_GCDS-SDGC" /> <!-- verify with AA with an email -->

<!-- GC Design System CSS Shortcuts -->
<link rel="stylesheet" href="/assets/gcds/gcds-css-shortcuts.min.css" />

<!-- GC Design System -->
<link rel="stylesheet" href="/assets/gcds/gcds.css" />
<script type="module" src="/assets/gcds/gcds.esm.js"></script>

<!-- GC Design System Extension - Code display -->
<script type="module" src="/assets/gcds/gcds-ext-code-display.esm.js"></script>

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />
