---
import { getBreadcrumbs } from '../utils/breadcrumbs';
import { resolveLocaleFromPathname } from '../utils/i18n';

interface Props {
  pathname?: string;
}

const pathname = (Astro.props as Props).pathname ?? Astro.url.pathname;
const locale = resolveLocaleFromPathname(pathname);
const items = getBreadcrumbs(pathname);

const hasVersion = /\/components\/\d+\.\d+\.\d+\//.test(Astro.url.pathname) || /\/composants\/\d+\.\d+\.\d+\//.test(Astro.url.pathname);

const Tag = hasVersion ? 'gcds-breadcrumbs-latest' : 'gcds-breadcrumbs';
const TagItem = hasVersion ? 'gcds-breadcrumbs-item-latest' : 'gcds-breadcrumbs-item';
---

<Tag lang={locale} slot="breadcrumb">
  {items.map((item) => (
    <TagItem href={item.href}>{item.text}</TagItem>
  ))}
</Tag>
