---
import SplashLayout from '../layouts/SplashLayout.astro';
---

<SplashLayout pageTitle="Welcome">
    <main class="splash-page" id="main-content">
        <div class="splash-background" aria-hidden="true"></div>

        <section class="splash-panel">
            <div class="splash-content">
                <gcds-signature></gcds-signature>

                <gcds-heading tag="h1" class="visibility-sr-only">GC Design System</gcds-heading>

                <div class="splash-buttons d-flex justify-content-center align-items-center gap-300 mt-400">
                    <gcds-button button-role="primary" type="link" href="/en">
                        English
                    </gcds-button>
                    <gcds-button button-role="primary" type="link" href="/fr">
                        Français
                    </gcds-button>
                </div>
            </div>

            <div class="splash-footer-row">
                <div class="splash-footer-links">
                    <gcds-link href="/en/terms-of-use" size="small" class="splash-footer-link">Terms of use</gcds-link>
                    <span class="splash-footer-sep" aria-hidden="true">•</span>
                    <gcds-link href="/fr/conditions-dutilisation" size="small" lang="fr" class="splash-footer-link">Conditions d’utilisation</gcds-link>
                </div>

                <gcds-signature type="wordmark">
                </gcds-signature>
            </div>
        </section>
    </main>
</SplashLayout>